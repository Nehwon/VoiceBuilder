# VoiceBuilder — variables d'environnement pour le mode « registre Gitea ».
# Utilisé avec :  docker-compose.gitea.yml
#
# Ce fichier tire les images depuis le registre container Gitea (construites
# par le CI) au lieu de les construire localement. Aucun build requis :
# `docker compose -f docker-compose.gitea.yml --env-file .env.gitea up -d`
# fera un `docker pull` automatique des images manquantes.

# --- Registre container Gitea ------------------------------------------------
# Hôte du registre Gitea (images construites par le CI).
# GITEA_REGISTRY=gitea.lamachere.fr

# Tag de l'image applicative à utiliser. Le CI publie :
#   latest, main, vX.Y.Z, X.Y.Z
# « latest » (défaut) = dernier build validé par le CI.
# GITEA_TAG=latest

# Port hôte exposé pour le GUI (8000 dans le conteneur).
# HOST_PORT=8001

# --- Source de téléchargement du modèle --------------------------------------
# "modelscope" (défaut) ou "huggingface" (miroir, si réseau/blocage).
# COSYVOICE_MODEL_SOURCE=modelscope

# --- Warmup au démarrage -----------------------------------------------------
# 1 = précharge modèle + Whisper en tâche de fond (1re inférence sans latence,
# ~7 Go VRAM occupés). 0 = comportement actuel (chargement paresseux).
# VOICEBUILDER_WARMUP=0
